# Copy to .env (locally and on the server). NEVER commit .env. DATABASE_URL is set by docker-compose on the server.
DATABASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
BASE_URL=http://localhost:8000
# Server only: public HTTPS name for Caddy, e.g. 206-81-28-155.sslip.io (then BASE_URL=https://<DOMAIN>)
DOMAIN=
PUBLIC_PORT=8000
